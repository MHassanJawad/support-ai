{
  "name": "@supportai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "tsx src/server.ts",
    "verify:services": "tsx src/verify-services.ts",
    "lint": "eslint src tests --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@google/generative-ai": "0.21.0",
    "@supabase/supabase-js": "2.116.0",
    "@supportai/shared": "workspace:*",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.1",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "multer": "2.4.0",
    "pdf-parse": "1.1.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "22.20.3",
    "@types/pdf-parse": "1.1.4",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.13.0",
    "tsx": "4.23.13",
    "typescript": "5.6.3",
    "vitest": "5.0.1"
  }
}
