{
  "name": "supportai",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant AI customer support SaaS with Supabase, pgvector, and Gemini.",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "audit": "pnpm audit --audit-level moderate",
    "test:e2e": "playwright test",
    "verify:services": "pnpm --filter @supportai/api verify:services"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "path-to-regexp@0.1": "0.1.13",
      "qs": "6.16.0",
      "postcss": "8.5.23",
      "js-yaml@4": "4.3.2",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "body-parser@1": "1.20.6",
      "nanoid@3": "3.3.18",
      "postcss-selector-parser@6": "6.1.3",
      "browserslist": "4.28.7",
      "baseline-browser-mapping": "2.11.0",
      "@eslint/plugin-kit": "0.3.4"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@typescript-eslint/eslint-plugin": "8.13.0",
    "@typescript-eslint/parser": "8.13.0",
    "eslint": "9.13.0",
    "typescript": "5.6.3"
  }
}
